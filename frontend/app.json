{
  "expo": {
    "name": "iTrust-The Social App",
    "slug": "iTrust-The Social App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/itrust-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#bce3ffff",
        "foregroundImage": "./assets/itrust-logo.png",
        "backgroundImage": "./assets/itrust-logo.png",
        "monochromeImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
  "expo-secure-store",
  [
    "expo-splash-screen",
    {
      "image": "./assets/itrust-logo.png",
      "imageWidth": 220,
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  ]
]
  }
}
